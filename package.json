{
  "name": "switchboard",
  "version": "0.1.0",
  "private": true,
  "description": "A dispatcher for many Claude agents at once, one per git worktree.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @switchboard/shared build && pnpm --parallel --filter \"./{shared,server,web}\" dev",
    "dev:server": "pnpm --filter @switchboard/server dev",
    "dev:web": "pnpm --filter @switchboard/web dev",
    "build": "pnpm --filter @switchboard/shared build && pnpm --filter @switchboard/web build && pnpm --filter @switchboard/server build",
    "start": "pnpm --filter @switchboard/server start",
    "typecheck": "pnpm --filter @switchboard/shared build && pnpm -r typecheck",
    "postinstall": "node scripts/ensure-node-pty.mjs",
    "ensure-native": "node scripts/ensure-node-pty.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
